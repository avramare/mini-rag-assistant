OLLAMA_HOST=http://localhost:11434
GEN_MODEL=
EMBED_MODEL=
JUDGE_MODEL=
# Context window sent to Ollama on every call (Ollama's own default is small and silently truncates).
NUM_CTX=4096
# Seconds to wait for a model reply. A judge timeout is retried once, then counted as judge_error.
OLLAMA_READ_TIMEOUT_S=120
# Flag a prompt as truncation risk when it uses more than this share of NUM_CTX.
MAX_PROMPT_CTX_SHARE=0.75
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
